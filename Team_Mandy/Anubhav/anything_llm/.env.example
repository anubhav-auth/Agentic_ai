# Copy to .env and edit. All values are optional; these are the defaults.
# NEVER commit .env -- it is gitignored, and this repo has a public remote.

# --- Vision backend: any OpenAI-compatible endpoint ---
# LOCAL (default): free, private, slower, less accurate.
LLM_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen2.5vl:3b
LLM_API_KEY=ollama

# REMOTE (OpenRouter): free vision model, UPLOADS EVERY FIGURE to a third party.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=google/gemma-4-26b-a4b-it:free
# LLM_API_KEY=sk-or-v1-...

# NVIDIA NIM (the lab's vendor): also an OpenAI-compatible endpoint, so it is a
# three-line swap. Get a free key at build.nvidia.com. Pick any vision-capable
# open-weights model, e.g. meta/llama-3.2-90b-vision-instruct.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# LLM_API_KEY=nvapi-...

# --- Text-extraction backend ---
# markitdown (default, fast, no ML models) or docling (the lab's engine:
# layout-aware, better tables, but heavy -- needs pip install -e ".[docling]").
PARSER=markitdown

# Cap the reply length. Without this OpenRouter reserves the model's full output
# window against your credit balance and rejects the call with a 402.
MAX_TOKENS=1024

# Ollama-only, ignored when remote. Ollama's default context is 4096, which a
# single full-page render exceeds on its own (~4200 image tokens), so scanned
# documents fail outright at the default. Do not go below ~6144.
NUM_CTX=8192

# --- Triage tuning ---
# Raise if logos/icons are being described; lower if small diagrams are missed.
MIN_AREA_RATIO=0.015
MIN_SIDE_PT=40
# Raise if tables are being mistaken for diagrams; lower if simple
# 3-box flowcharts are being missed.
VECTOR_MIN_SHAPES=4

# --- Rendering ---
# Raise to 300 if the model misreads small labels (costs more tokens/time).
RENDER_DPI=200
# Hard cap on the long side in pixels. Vision models bill by pixel area, so this
# is what stops a big page or phone photo from overrunning the context.
# Raising it needs a matching NUM_CTX rise.
MAX_RENDER_PX=1400

# --- AnythingLLM ---
# The desktop app serves its API on 3001 only while the window is OPEN.
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_WORKSPACE=docprep
# Settings -> Tools -> Developer API -> Generate New API Key
ANYTHINGLLM_API_KEY=
